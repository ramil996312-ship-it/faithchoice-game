# Секреты — никогда не коммитить
.tts-key.txt
.cloudflare-token.txt
.codemagic-token
AuthKey_*.p8

# Зависимости — переустанавливаются по package.json
node_modules/

# Готовая озвучка (500 МБ бинарных mp3, регенерируется скриптами в tts-test/ через Google Cloud TTS)
tts-audio/

# Озвучка резервных 50 историй (только для reserve-preview.html, не для живой игры)
audio/

# Локальные бэкапы проекта/сервера (большие, не для репозитория)
backups/

# Локальные служебные состояния инструментов
.netlify/
.claude/

# Android (Capacitor) — сборочные артефакты и локальные кэши, пересоздаются `npx cap sync`/gradlew
android/build/
android/app/build/
android/.gradle/
android/app/.cxx/
android/local.properties
android/captures/
*.apk
*.aab

# Ключ подписи релиза — СЕКРЕТ. Если потерять его без бэкапа — обновить опубликованное
# в Google Play приложение станет невозможно. Держите отдельную резервную копию (не только здесь).
android/keystore/
android/keystore.properties
keystore-backup-COPY-ME/

# iOS (Capacitor), если/когда появится
ios/App/build/
ios/App/Pods/
